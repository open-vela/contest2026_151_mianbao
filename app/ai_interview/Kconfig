#
# AI模拟面试官 Kconfig 配置
#

config APP_AI_INTERVIEW
	tristate "AI Interview Simulator"
	default y
	---help---
		Enable the AI Interview Simulator application.
		This app provides voice-based interview simulation
		using cloud-based ASR/TTS/LLM services.

if APP_AI_INTERVIEW

config APP_AI_INTERVIEW_PROGNAME
	string "Program name"
	default "ai_interview"
	---help---
		This is the name of the program for NSH.

config APP_AI_INTERVIEW_PRIORITY
	int "Task priority"
	default 100

config APP_AI_INTERVIEW_STACKSIZE
	int "Stack size"
	default 32768
	---help---
		Main task stack. libcurl needs a large stack (see
		CONFIG_EXAMPLES_HTTP_STACKSIZE, default 204800); the network
		work itself runs on a worker thread, this only needs to cover
		the state machine, button scanning and log output.

config APP_AI_INTERVIEW_WORKER_STACKSIZE
	int "Network/audio worker stack size"
	default 262144
	---help---
		Stack for the worker thread that runs capture / upload /
		playback. Must be large: libcurl plus mbedTLS.

config APP_AI_INTERVIEW_CLOUD_URL
	string "Cloud server base URL (without path)"
	default "http://172.20.10.2:5000"
	---help---
		Base URL of the Flask service in cloud/. The paths
		/api/interview and /api/health are appended by the code.
		Can be overridden at runtime:  nsh> set CLOUD_URL http://...

config APP_AI_INTERVIEW_ROLE
	string "Interview role"
	default "产品经理"

config APP_AI_INTERVIEW_TLS_INSECURE
	bool "Skip TLS certificate verification (demo only)"
	default n
	---help---
		Leave this OFF unless you must talk to the cloud over https
		and have no CA bundle on the device.

		This board's rootfs ships no CA certificates
		(CONFIG_LIB_CURL_CA_PATH points at /etc/ssl/curl, which does
		not exist), so an https:// URL will fail the handshake with
		verification on. Prefer installing a CA bundle and setting
		CURLOPT_CAINFO instead of enabling this.

		Turning this on disables certificate verification, which makes
		the connection vulnerable to man-in-the-middle attacks. Only
		acceptable when pointed at your own server for a demo.

		Has no effect when the cloud URL uses plain http://.

config APP_AI_INTERVIEW_MAX_RECORD_SECONDS
	int "Max recording seconds per round"
	default 30

config APP_AI_INTERVIEW_SILENCE_THRESHOLD
	int "Silence detection RMS threshold (16-bit full scale)"
	default 500

endif
