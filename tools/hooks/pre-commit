#!/bin/sh
#
# 提交前闸门：仓库里混入了 API key 就不许提交。
#
# 为什么要在代码里拦：本项目的 MIMO_API_KEY 真的进过 git 历史（commit 812a1b5、f948ff7，
# 涉及 cloud/ 下 4 个文件），之后删文件也删不掉，只能轮换 —— 而那两个提交至今仍能在
# 官方公开仓里读到。靠"记得手动跑一遍"是拦不住的，交给钩子。
#
# 扫描范围是**全仓被跟踪的文本文件**（2026-09-29 起；此前只扫 logs/，而当年真正
# 泄露的那次恰恰不在 logs/ 里 —— 见 tools/redact_secrets.sh 头部）。
#
# 安装（core.hooksPath 是 local 配置、不能入库，所以**每个克隆都要执行一次**）：
#     git config core.hooksPath tools/hooks
#
# 判据由 tools/redact_secrets.sh --check 给出：发现疑似密钥时退出码为 1，提交即被中止。
# 确需绕过时用 git commit --no-verify —— 知道自己在做什么再用。

exec "$(git rev-parse --show-toplevel)/tools/redact_secrets.sh" --check
